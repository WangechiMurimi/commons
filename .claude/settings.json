{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pnpm dev)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm test:watch)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm format)",
      "Bash(pnpm format:check)",
      "Bash(pnpm build)",
      "Bash(pnpm e2e)",
      "Bash(pnpm e2e *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright test *)",
      "Bash(pnpm install)",
      "Bash(pnpm list *)",
      "Bash(pnpm why *)",
      "Bash(pnpm outdated)",

      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",

      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",

      "PowerShell(pnpm test *)",
      "PowerShell(pnpm lint *)",
      "PowerShell(pnpm typecheck)",
      "PowerShell(pnpm build)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",

      "Edit(src/**)",
      "Edit(e2e/**)",
      "Edit(docs/**)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Edit(package.json)",
      "Edit(.github/**)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(npm *)",
      "Bash(yarn *)",
      "Bash(netlify deploy --prod*)",
      "Bash(supabase db reset*)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(git push --force*)",
      "PowerShell(Get-Content .env*)"
    ]
  }
}
